{
  "description": "Forward Codex task state to a local Agent Monitor BLE bridge.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/PATH/TO/agent-monitor-bridge\" hook",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/PATH/TO/agent-monitor-bridge\" hook",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/PATH/TO/agent-monitor-bridge\" hook",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/PATH/TO/agent-monitor-bridge\" hook",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/PATH/TO/agent-monitor-bridge\" hook",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/PATH/TO/agent-monitor-bridge\" hook",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/PATH/TO/agent-monitor-bridge\" hook",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/PATH/TO/agent-monitor-bridge\" hook",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/PATH/TO/agent-monitor-bridge\" hook",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
